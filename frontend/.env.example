# Copy to .env.local for `npm run dev`. Never commit .env.local.
# Free key from https://cloud.maptiler.com (Account -> API keys). Leave empty to use OpenStreetMap tiles.
VITE_MAPTILER_KEY=
# Map style, e.g. streets-v2-dark, dataviz-dark, streets-v2
VITE_MAPTILER_STYLE=streets-v2-dark

# Who runs this installation (shown on the landing, privacy and terms pages)
VITE_OPERATOR_NAME=
VITE_CONTACT_EMAIL=
VITE_CITY=Mumbai
