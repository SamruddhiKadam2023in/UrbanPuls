# Copy to .env and fill in real values. Never commit .env.
# ENVIRONMENT=production turns on the production safety checks (strong SECRET_KEY, PostgreSQL, no demo YOLO)
ENVIRONMENT=development
DATABASE_URL=sqlite:///./tpms.db
SECRET_KEY=change-this-to-a-random-secret-key-in-production
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
TIMEZONE=Asia/Kolkata

# Rate limiting store. memory:// is fine for one process; use redis://... with several workers
RATE_LIMIT_STORAGE_URI=memory://

# Email for verification and password reset. Leave SMTP_HOST empty to print emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=UrbanPuls <no-reply@example.com>

# Booking rules
BOOKING_GRACE_MINUTES=15
MAX_ACTIVE_RESERVATIONS=2
NO_SHOW_LIMIT=3

# Optional: Cloudinary for complaint photos (local disk is used when empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Twilio SMS to police (skipped when empty)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
POLICE_PHONE_NUMBER=
